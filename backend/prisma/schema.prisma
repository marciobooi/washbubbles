generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
}

model Machine {
  id        String   @id @default(cuid())
  name      String
  status    Json?
  cycle     Int?     @default(0)
  createdAt DateTime @default(now())
}

model Sale {
  id         String   @id @default(cuid())
  machineId  String
  machine    Machine  @relation(fields: [machineId], references: [id])
  amount     Float
  items      Json
  createdAt  DateTime @default(now())
}
