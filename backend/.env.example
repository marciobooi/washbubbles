# Database
# MONGODB_URL (local): mongodb://localhost:27017/washstore
MONGODB_URL=mongodb://localhost:27017/washstore

# JWT secret for admin authentication
JWT_SECRET=supersecretadminjwt

# Backend port
PORT=3000

# Optional websocket port
WS_PORT=8080
KIOSK_PASSWORD=kiosk1234
ADMIN_PASSWORD=admin1234

# UniFi Network Controller — issues the post-purchase guest-WiFi voucher.
# Toggle/duration/SSID live in Admin > Settings > WiFi, not here.
UNIFI_HOST=
UNIFI_PORT=8443
UNIFI_SITE=default
UNIFI_USERNAME=
UNIFI_PASSWORD=
# UDM/UDM Pro (UniFi OS) console: set to /proxy/network. Classic software
# controller: leave empty.
UNIFI_BASE_PATH=
# Self-signed cert on the controller (the common case for a local install) —
# leave false. Set true only if the controller has a real trusted cert.
UNIFI_VERIFY_SSL=false

# Outbound email — password reset, operator alerts (Admin > Definições >
# Alertas), day-close (Fecho de Caixa) reports, customer receipts, and the
# marketing broadcast (Admin > Definições > Alertas covers the "who gets
# notified" side, but sending anything at all needs this). With none of these
# set, mailer.js just logs what it would have sent — safe for local dev, but
# those features are effectively off without it.
#
# Production mailbox: marcacoes@freshbubbles.pt, hosted at amen.pt. Their
# documented SMTP settings (as of 2026-09, amen.pt/assistencia/configuracao-email):
#   host smtp-pt.securemail.pro, port 465, SSL, username = the full address.
# MAIL_PASS is the mailbox password from amen.pt's control panel — not in
# this file; get it from whoever manages the freshbubbles.pt account and set
# it directly in the real (gitignored) .env, never commit it.
MAIL_HOST=smtp-pt.securemail.pro
MAIL_PORT=465
MAIL_USER=marcacoes@freshbubbles.pt
MAIL_PASS=
MAIL_FROM=marcacoes@freshbubbles.pt
# MAIL_FROM_NAME=Fresh Bubbles          # optional "Display Name <address>" on outgoing mail

# --- Low-level controller (shop hardware behind a TCP/JSON gateway) ---------
# Set LOWLEVEL_HOST (or LOWLEVEL_ENABLED=true) to drive the coin/bill acceptors,
# hopper, card dispenser, RFID writer, printer and machine interfaces through the
# controller instead of local serial ports. Shop: 192.168.2.201 : 16852.
# LOWLEVEL_ENABLED=true
# LOWLEVEL_HOST=192.168.2.201
# LOWLEVEL_PORT=16852
# LOWLEVEL_STATUS_POLL_MS=60000   # status_per/status_int poll, 0 = off
# LOWLEVEL_BUSY_POLL_MS=10000     # re-poll interval while a machine is running
# LOWLEVEL_TRACE=true             # log every inbound controller message
# --- Single-PC kiosk install --------------------------------------------------
# SERVE_FRONTEND=true             # serve ../dist from this process
# HOST=127.0.0.1                  # bind address (default: all interfaces)

# --- Card <-> database balance sync (controller mode) ---------------------------
# The card carries its balance and identity as well as this database; every balance
# change is written to the card at the reader, and a card meeting an unknown or
# out-of-step database is adopted / reconciled. Active only with LOWLEVEL_* set.
# CARD_SYNC=false                 # turn the sync off
# CARD_SYNC_MAX_BALANCE=1000      # largest balance (EUR) believed from a card

# --- Central sync: offline-first queue (services/uplink.js) ---------------------
# Sales (coins, bills, cards), card balances and day-closes are always recorded
# locally first and queued; they are pushed to the central server whenever it can
# be reached. Unset = disabled (nothing is queued).
# SYNC_SERVER_URL=https://api.washbubbles.app/api
# SYNC_API_KEY=<kiosk key issued by the central server>
# SYNC_ENABLED=false               # switch off without removing the settings
# --- Inserted-cash recovery (services/cashSession.js) -------------------------
# DATA_DIR=<folder>                # where cash-session.json lives (default backend/data)
# CASH_SESSION_RESTORE_MINUTES=30  # cash older than this is reported, not restored
