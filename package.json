{
  "name": "washstore",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:dev": "npm --prefix backend install --no-audit --no-fund && node -e \"const fs=require('fs'); const src='backend/.env.example'; const dst='backend/.env'; if(!fs.existsSync(dst) && fs.existsSync(src)){let s=fs.readFileSync(src,'utf8'); s=s.replace(/@db:/g,'@localhost:'); fs.writeFileSync(dst,s); console.log('Created backend/.env from example (db -> localhost)');}\"",
    "dev": "concurrently \"npm --prefix backend run dev\" \"vite\"",
    "dev:no-db": "npm run prepare:dev && concurrently \"npm --prefix backend run dev\" \"vite\"",
    "dev:db:setup": "npm --prefix backend run seed",
    "dev:backend": "npm --prefix backend run dev",
    "build": "vite build",
    "preview": "vite preview",
    "package:agent": "pkg backend/src/agentServer.js --targets node18-win-x64 --output dist-agent/hardware-agent.exe"
  },
  "postinstall": "npm --prefix backend install",
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.1.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-joyride": "^2.9.3",
    "react-router-dom": "^7.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "i18next": "^23.0.1",
    "react-i18next": "^13.0.1"
  },
  "dependenciesMeta": {
    "@tanstack/react-query": {
      "optional": false
    }
  },
  "overrides": {
    "react-joyride": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "react-floater": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^7.6.0",
    "pkg": "^5.8.1",
    "shadcn": "^3.6.2",
    "tailwindcss": "^4.0.0",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^5.1.0"
  }
}
