{
  "name": "washstore",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "prepare:dev": "npm --prefix backend install --no-audit --no-fund && node -e \"const fs=require('fs'); const src='backend/.env.example'; const dst='backend/.env'; if(!fs.existsSync(dst) && fs.existsSync(src)){let s=fs.readFileSync(src,'utf8'); s=s.replace(/@db:/g,'@localhost:'); fs.writeFileSync(dst,s); console.log('Created backend/.env from example (db -> localhost)');}\"",
    "dev": "concurrently \"npm --prefix backend run dev\" \"vite\"",
    "dev:no-db": "npm run prepare:dev && concurrently \"npm --prefix backend run dev\" \"vite\"",
    "dev:db:setup": "npm --prefix backend run seed",
    "dev:backend": "npm --prefix backend run dev",
    "build": "vite build",
    "preview": "vite preview",
    "electron:start": "electron . --url=http://localhost:5173",
    "electron:load": "electron . --url=dist/index.html",
    "electron:dev": "echo 'Run `npm run dev` in a terminal and, in another, run `npm run electron:start`'",
    "dev:electron": "concurrently \"npm run dev\" \"cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "dev:full": "concurrently \"npm run dev\" \"cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "package:electron": "npm run build && electron-builder --win --x64",
    "package:agent": "pkg backend/src/agentServer.js --targets node18-win-x64 --output dist-agent/hardware-agent.exe"
  },
  "postinstall": "npm --prefix backend install",
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.1.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-joyride": "^2.9.3",
    "react-router-dom": "^7.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "i18next": "^23.0.1",
    "react-i18next": "^13.0.1"
  },
  "dependenciesMeta": {
    "@tanstack/react-query": {
      "optional": false
    }
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^7.6.0",
    "cross-env": "^7.0.3",
    "electron": "^26.6.10",
    "electron-builder": "^24.0.0",
    "pkg": "^5.8.1",
    "postcss": "^8.4.0",
    "shadcn": "^3.6.2",
    "tailwindcss": "^4.0.0",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^5.1.0",
    "wait-on": "^7.0.0"
  },
  "build": {
    "appId": "com.washbubbles.pos",
    "productName": "WashBubbles POS",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
