# Copy this to .env.docker at the repo root and fill in real values, then run:
#   docker compose --env-file .env.docker up --build
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
KIOSK_API_KEY=REPLACE_WITH_A_LONG_RANDOM_KEY
ADMIN_PASSWORD=admin1234
KIOSK_PASSWORD=kiosk1234

# Outbound email (optional) — password reset, day-close reports, receipts,
# alerts. See docs/SHOP-HARDWARE-AND-COMMUNICATIONS.md §15. Leave MAIL_HOST
# blank and the backend logs instead of sending (safe default).
MAIL_HOST=smtp-pt.securemail.pro
MAIL_PORT=587
MAIL_USER=marcacoes@freshbubbles.pt
MAIL_PASS=
MAIL_FROM=marcacoes@freshbubbles.pt
